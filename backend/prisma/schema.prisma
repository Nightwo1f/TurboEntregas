generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  VIP
}

enum BatchStatus {
  OPEN
  PROCESSING
  DONE
  CANCELLED
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  plan         Plan        @default(FREE)
  batches      PhotoBatch[]
  routes       RoutePlan[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model PhotoBatch {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    BatchStatus @default(OPEN)
  maxPhotos Int
  photos    Photo[]
  addresses Address[]
  routePlan RoutePlan?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Photo {
  id               String   @id @default(cuid())
  batchId          String
  batch            PhotoBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  imageUrl         String
  ocrText          String?
  extractedAddress String?
  address          Address?
  createdAt        DateTime @default(now())
}

model Address {
  id          String   @id @default(cuid())
  batchId     String
  batch       PhotoBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  photoId     String   @unique
  photo       Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  rawText     String
  address     String
  latitude    Float
  longitude   Float
  isConfirmed Boolean  @default(false)
  orderIndex  Int?
  createdAt   DateTime @default(now())
}

model RoutePlan {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  batchId              String   @unique
  batch                PhotoBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  originLatitude       Float
  originLongitude      Float
  totalDistanceMeters  Int
  totalDurationSeconds Int
  createdAt            DateTime @default(now())
}
