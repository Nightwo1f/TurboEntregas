{
  "name": "turboentregas",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo do RouteSnap Delivery App.",
  "workspaces": [
    "mobile",
    "backend"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w backend",
    "dev:mobile": "npm run start -w mobile",
    "build": "npm run build -w backend && npm run typecheck -w mobile",
    "lint": "npm run lint -w backend && npm run lint -w mobile",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,prisma}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0"
  }
}
